  "patterns": {
    "^(?P<indent> *)R_\\{(?P<name>valid|extract)\\}\\s*:=\\s*(?P<pattern>\\^.*)$": "\\g<indent>R\\g<name> := \\g<name>Pattern // \\g<pattern>",
    "^( *)\\|(?=.*\\\\[.d])(.*)$": "\\1// |\\2",
    "print :\\)": "print noMatch",
    "(?:\\x60\\x60|\")(?P<literal>[A-Za-z0-9]+)\"": "word(\\g<literal>)",
    "\"\\(\"": "leftParen",
    "\"\\)\"": "rightParen",
    "\"\\+\"": "plusSign",
    "\"\\*\"": "starSign",
    "(=\\s*|≠\\s*)\\((?=\\s*(?:then\\b|,|$))": "\\1leftParen",
    "(=\\s*|≠\\s*)\\)(?=\\s*(?:then\\b|,|$))": "\\1rightParen",
    "\\b(consume|match|push)\\(\\(\\)": "\\1(leftParen)",
    "\\b(consume|match|push)\\(\\)\\)": "\\1(rightParen)",
    "\\b([a-zA-Z][a-zA-Z0-9]*)\\s*:=:\\s*([a-zA-Z][a-zA-Z0-9]*)\\b": "swap(\\1, \\2)",
    "\\b(?:Вход|Input):": "input:",
    "\\bВыход:": "output:",
    "продвинуться к первому токену": "advanceToFirstToken()",
    "Симулировать работу M на ω ровно k шагов \\(определение шагов МТ см\\. 2\\.5\\.1\\)\\.?": "simulate(M, omega, k)",
    "M остановилась за эти k шагов": "halted(M, k)",
    "Извлечь блок C из W": "C := pop(W)",
    "Разбить D на D_1 = D ∩X и D_2 = D ∖X": "D1 := D intersect X; D2 := D difference X",
    "Заменить D в P на D_1 и D_2": "replace(P, D, D1, D2)",
    "Добавить в W меньший из блоков D_1, D_2": "add(W, smaller(D1, D2))",
    "Построить ДКА по финальному разбиению P": "buildDFA(P)",
    "имеет не меньший приоритет, чем x": "hasPriorityAtLeast(x)",
    "выполнять свёртку": "reduce()",
    "\\bПока\\b": "while",
    "\\bЕсли\\b": "if",
    "\\bто\\b": "then",
    "\\bДля\\b": "for",
    "^\\|x\\|(?=\\s*≝)": "abs(x)",
    "\\b([A-Za-z][A-Za-z0-9]*)\\.push\\(": "push(\\1, ",
    "\\b([A-Za-z][A-Za-z0-9]*)\\.pop\\(\\)": "pop(\\1)",
    "\\b([A-Za-z][A-Za-z0-9]*)\\.top\\b": "top(\\1)",
    "\\bРезультат: верхний элемент стека V\\.": "return top(V)",
    "\\bИнициализация:": "initialize:",
    "\\bРекуррентное заполнение:": "fillByLength:",
    "\\bfor kazhdogo\\b": "for each",
    "\\b(?:x) --- (?=операнд|операция)": "x is ",
    "\\bи\\b": "and",
    "^\\s*j\\s*←": "j := ",
    "(?<=\\])\\s*←(?=\\s*[{⋃])": " := ",
    "\\|([^|]+)\\|": "size(\\1)",
    "(?<=\\w)_\\{(\\w+)\\+(\\w+)\\}": "At(\\1+\\2)",
    "(?<=\\w)_\\{(\\w+)-(\\w+)\\}": "At(\\1-\\2)",
    "_\\{([\\w_]+)\\}": "\\1",
    "(?<!\\.)\\.\\.(?!\\.)": " to ",
    "\\b([A-Za-z][A-Za-z0-9]*)\\.([A-Za-z][A-Za-z0-9]*)\\b": "\\1 \\2",
    "\\\\textbackslash\\b": " backslash ",
    "\\\\overline\\{([^{}]+)\\}": "bar(\\1)",
    "\\\\\\s+": " "
  },
